import pandas as pd
import re
import nltk
import gensim
from gensim import corpora
from nltk.sentiment.vader import SentimentIntensityAnalyzer
from nltk.corpus import stopwords
from nltk.tokenize import word_tokenize
from nltk.stem import WordNetLemmatizer
from sklearn.feature_extraction.text import CountVectorizer

# ✅ Download required NLTK datasets
nltk.download('stopwords')
nltk.download('punkt')
nltk.download('wordnet')
nltk.download('vader_lexicon')

# ✅ Initialize NLP tools
stop_words = set(stopwords.words('english'))
lemmatizer = WordNetLemmatizer()
sid = SentimentIntensityAnalyzer()

# ✅ **Preprocess text**
def clean_text(text):
    if isinstance(text, str):
        text = re.sub(r'http\S+|www\S+|https\S+', '', text, flags=re.MULTILINE)  # Remove URLs
        text = re.sub(r'@\w+', '', text)  # Remove mentions
        text = re.sub(r'#\w+', '', text)  # Remove hashtags
        text = re.sub(r'[^a-zA-Z\s]', '', text)  # Keep only words
        text = text.strip()
        return text
    return text

df['text'] = df['text'].astype(str)
df['text'] = df['text'].apply(clean_text)

# ✅ **Tokenization, Lemmatization, Stop Word Removal**
def process_text(text):
    tokens = word_tokenize(text.lower())  # Convert to lowercase
    tokens = [token for token in tokens if token not in stop_words and token.isalpha()]  # Remove stop words
    tokens = [lemmatizer.lemmatize(token) for token in tokens]  # Lemmatization
    return tokens

df['processed_text'] = df['text'].apply(process_text)

# ✅ **LDA Topic Modeling**
# Create dictionary and corpus
dictionary = corpora.Dictionary(df['processed_text'])
corpus = [dictionary.doc2bow(text) for text in df['processed_text']]

# Train LDA model
lda_model = gensim.models.LdaModel(corpus, num_topics=2, id2word=dictionary, passes=10)

# ✅ **Assign topics (Trump or Harris)**
def classify_topic(text):
    bow = dictionary.doc2bow(text)
    topic_distribution = lda_model.get_document_topics(bow)

    if len(topic_distribution) > 0:
        topic = max(topic_distribution, key=lambda x: x[1])[0]  # Get dominant topic
        return "Trump" if topic == 0 else "Harris"
    return "Unknown"

df['topic'] = df['processed_text'].apply(classify_topic)

# ✅ **Apply VADER sentiment analysis**
df['compound'] = df['text'].apply(lambda x: sid.polarity_scores(x)['compound'])

# ✅ **Categorize sentiment**
def categorize_sentiment(compound_score):
    if compound_score >= 0.05:
        return 'Positive'
    elif compound_score <= -0.05:
        return 'Negative'
    else:
        return 'Neutral'

df['sentiment'] = df['compound'].apply(categorize_sentiment)

# ✅ Ensure proper topic filtering
trump_sentiment = df[df['topic'].str.contains(r'\b(trump|donald trump|donald)\b', case=False, na=False)]['compound'].mean()
harris_sentiment = df[df['topic'].str.contains(r'\b(harris|kamala harris|kamala)\b', case=False, na=False)]['compound'].mean()

# ✅ Predict Winner
if trump_sentiment > harris_sentiment:
    winner = "Trump"
elif harris_sentiment > trump_sentiment:
    winner = "Harris"
else:
    winner = "Too Close to Call"

# ✅ Print Results
print("\n🔵 Harris Sentiment Score:", harris_sentiment)
print("🔴 Trump Sentiment Score:", trump_sentiment)
print("\n🏆 Predicted Winner:", winner)
